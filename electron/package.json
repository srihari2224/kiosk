{
  "name": "prinit-electron",
  "version": "1.0.0",
  "description": "Prinit Desktop Printing App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --publish never",
    "build:dir": "electron-builder --dir",
    "dist": "electron-builder --publish=never",
    "publish": "electron-builder --publish=always"
  },
  "build": {
    "appId": "com.Print-IT.desktop",
    "productName": "Print-IT",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "node_modules/**/*",
      "storage/**/*",
      "prices.json",
      "logs/**/*",
      "temp/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/rocket.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/rocket.ico",
      "uninstallerIcon": "assets/rocket.ico",
      "installerHeaderIcon": "assets/rocket.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prinit"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/rocket.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/rocket.ico"
    }
  },
  "devDependencies": {
    "electron": "^37.2.5",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "electron-updater": "^6.6.2",
    "fs-extra": "^11.3.0",
    "node-printer": "^1.0.4",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.6.1",
    "pdfjs-dist": "^5.4.54"
  },
  "keywords": [
    "printing",
    "desktop",
    "electron"
  ],
  "author": "Prinit Team",
  "license": "ISC"
}
